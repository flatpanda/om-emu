+/*
+ * om-isc (oracle only): back the OM-1 Cortex-A53 ISC hardware windows and wire
+ * the ISC receive doorbell to the GIC, so the camera's real A53 Linux can bring
+ * ISC up on virt. Enabled by the env var OM_ISC_MEMDEV (a memory-backend id);
+ * OM_ISC_CHARDEV names the doorbell chardev, OM_ISC_UARTDEV an optional chardev
+ * feeding the A53 console's RX. See tools/a53-oracle/.
+ * The irqcon banks sit at GIC SPIs 0x1c0/0x1c2/0x1c4/0x1c6 (the A53's irqcon
+ * driver requires irq-0x1c0 <= 7); NUM_IRQS is widened above to fit them.
+ */
+static void create_om_isc(VirtMachineState *vms)
+{
+    const char *memid = getenv("OM_ISC_MEMDEV");
+    const char *chrid = getenv("OM_ISC_CHARDEV");
+    const char *uartid = getenv("OM_ISC_UARTDEV");
+    Object *be;
+    DeviceState *dev;
+    int n;
+
+    if (!memid) {
+        return;
+    }
+    be = object_resolve_path_type(memid, TYPE_MEMORY_BACKEND, NULL);
+    if (!be) {
+        error_report("OM_ISC_MEMDEV: no memory-backend '%s'", memid);
+        exit(1);
+    }
+    dev = qdev_new("om-isc");
+    object_property_set_link(OBJECT(dev), "memdev", be, &error_fatal);
+    if (chrid) {
+        Chardev *c = qemu_chr_find(chrid);
+        if (c) {
+            qdev_prop_set_chr(dev, "chardev", c);
+        }
+    }
+    if (uartid) {
+        Chardev *c = qemu_chr_find(uartid);
+        if (c) {
+            qdev_prop_set_chr(dev, "uart", c);
+        }
+    }
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    for (n = 0; n < 4; n++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), n,
+                           qdev_get_gpio_in(vms->gic, 0x1c0 + 2 * n));
+    }
+    /* ttyS0 (mn_sio_uart 0x9a500600): DT SPIs 0x15e "tx", 0x15d "rx" */
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 4, qdev_get_gpio_in(vms->gic, 0x15e));
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 5, qdev_get_gpio_in(vms->gic, 0x15d));
+}
+
